index 0000000..5a7add6
--- /dev/null
+++ b/packages/desktop/src/features/browser-automation/native-bridge.test.ts
@@ -0,0 +1,275 @@
+import { EventEmitter } from "node:events";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { registerNativeBrowserBridgeIpc } from "./native-bridge.js";
+
+// Electron's IPC transport and WebContents live outside the Node test runner.
+// Invoke the registered handlers against an instrumented guest to control CDP timing.
+const registration = vi.hoisted(() => ({
+  guests: new Map<string, { hostId: number; workspaceId: string; contents: unknown }>(),
+}));
+vi.mock("electron", () => ({ ipcMain: {}, nativeImage: {} }));
+vi.mock("../browser-webviews/index.js", () => ({
+  getPaseoBrowserWebContentsForHostWindow: (browserId: string, hostId: number) => {
+    const guest = registration.guests.get(browserId);
+    return guest?.hostId === hostId ? guest.contents : null;
+  },
+  getPaseoBrowserWorkspaceId: (browserId: string) =>
+    registration.guests.get(browserId)?.workspaceId ?? null,
+}));
+
+class GuestDebugger extends EventEmitter {
+  private attached = false;
+  public attach() {
+    this.attached = true;
+  }
+  public isAttached() {
+    return this.attached;
+  }
+  public sendCommand = vi.fn(
+    async (method: string, _params: Record<string, unknown>): Promise<unknown> => {
+      if (method === "Page.getLayoutMetrics")
+        return { cssVisualViewport: { clientWidth: 1600, clientHeight: 1200 } };
+      if (method === "Page.captureScreenshot")
+        return { data: Buffer.from("fresh jpeg").toString("base64") };
+      if (method === "Target.getTargetInfo")
+        return { targetInfo: { targetId: "own-target", browserContextId: "own-context" } };
+      return {};
+    },
+  );
+}
+class Guest extends EventEmitter {
+  public readonly debugger = new GuestDebugger();
+  public destroyed = false;
+  public throttled = true;
+  public constructor(public readonly id: number) {
+    super();
+  }
+  public isDestroyed() {
+    return this.destroyed;
+  }
+  public getBackgroundThrottling() {
+    return this.throttled;
+  }
+  public setBackgroundThrottling(value: boolean) {
+    this.throttled = value;
+  }
+}
+const identity = { browserId: "browser", workspaceId: "workspace" };
+function fixture() {
+  const host = new Guest(1);
+  const guest = new Guest(2);
+  registration.guests.set(identity.browserId, {
+    hostId: host.id,
+    workspaceId: identity.workspaceId,
+    contents: guest,
+  });
+  const handlers = new Map<string, (event: unknown, ...args: unknown[]) => unknown>();
+  registerNativeBrowserBridgeIpc({
+    handle: (channel, handler) => {
+      handlers.set(channel, handler);
+    },
+  });
+  const call = async (channel: string, input: Record<string, unknown> = {}, sender = host) => {
+    const handler = handlers.get(`paseo:browser:native-${channel}`);
+    if (!handler) throw Error("Missing native IPC handler");
+    return handler({ sender }, { ...identity, ...input });
+  };
+  return { host, guest, call };
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(10000);
+});
+afterEach(() => {
+  registration.guests.clear();
+  vi.useRealTimers();
+});
+
+describe("native browser IPC", () => {
+  test("inspects paused call frames before resuming the original Runtime command", async () => {
+    const { guest, call } = fixture();
+    const running = Promise.withResolvers<unknown>();
+    const started = Promise.withResolvers<void>();
+    guest.debugger.sendCommand.mockImplementation(async (method) => {
+      if (method === "Runtime.evaluate") {
+        started.resolve();
+        return running.promise;
+      }
+      if (method === "Debugger.evaluateOnCallFrame") return { result: { value: 42 } };
+      if (method === "Runtime.getProperties")
+        return { result: [{ name: "local", value: { value: 42 } }] };
+      if (method === "Debugger.resume") running.resolve({ result: { value: "done" } });
+      return {};
+    });
+    const evaluating = call("command", { method: "Runtime.evaluate" });
+    await started.promise;
+    await expect(
+      call("command", {
+        method: "Debugger.evaluateOnCallFrame",
+        params: { callFrameId: "frame", expression: "local" },
+      }),
+    ).resolves.toEqual({ result: { value: 42 } });
+    await expect(
+      call("command", { method: "Runtime.getProperties", params: { objectId: "scope" } }),
+    ).resolves.toEqual({ result: [{ name: "local", value: { value: 42 } }] });
+    await call("command", { method: "Debugger.resume" });
+    await expect(evaluating).resolves.toEqual({ result: { value: "done" } });
+  });
+
+  test("captures a fresh bounded image when a quiet page has no new screencast paints", async () => {
+    const { guest, call } = fixture();
+    const first = await call("frame");
+    expect(first).toEqual({
+      data: `data:image/jpeg;base64,${Buffer.from("fresh jpeg").toString("base64")}`,
+      width: 1280,
+      height: 960,
+      capturedAt: 10000,
+    });
+    await vi.advanceTimersByTimeAsync(1600);
+    const next = await call("frame", { notBefore: 11000 });
+    expect(next).toEqual({
+      data: `data:image/jpeg;base64,${Buffer.from("fresh jpeg").toString("base64")}`,
+      width: 1280,
+      height: 960,
+      capturedAt: 11600,
+    });
+    expect(
+      guest.debugger.sendCommand.mock.calls.filter(
+        ([method]) => method === "Page.captureScreenshot",
+      ),
+    ).toHaveLength(2);
+  });
+  test("refuses requests from another host or workspace before reaching the debugger", async () => {
+    const { guest, call } = fixture();
+    await expect(call("command", { method: "DOM.getDocument" }, new Guest(9))).rejects.toThrow(
+      /host window and workspace/,
+    );
+    await expect(call("events", { workspaceId: "elsewhere" })).rejects.toThrow(
+      /host window and workspace/,
+    );
+    await expect(call("frame", { browserId: "missing" })).rejects.toThrow(
+      /host window and workspace/,
+    );
+    await expect(call("command", { method: "invalid" })).rejects.toThrow();
+    expect(guest.debugger.sendCommand).not.toHaveBeenCalled();
+  });
+
+  test("restricts browser-wide commands and maps cookies and permissions to the registered guest", async () => {
+    const { guest, call } = fixture();
+    await expect(call("command", { method: "Browser.close" })).rejects.toThrow(
+      /outside the native guest/,
+    );
+    await expect(call("command", { method: "Target.attachToTarget" })).rejects.toThrow(/tab tools/);
+    await expect(
+      call("command", { method: "Storage.getCookies", params: { browserContextId: "foreign" } }),
+    ).rejects.toThrow(/outside the native guest/);
+    await expect(
+      call("command", {
+        method: "Runtime.evaluate",
+        params: { expression: "x".repeat(2 * 1024 * 1024) },
+      }),
+    ).rejects.toThrow(/size limit/);
+    expect(guest.debugger.sendCommand).not.toHaveBeenCalled();
+    await expect(call("command", { method: "Target.getTargets" })).resolves.toEqual({
+      targetInfos: [{ targetId: "own-target", browserContextId: "own-context" }],
+    });
+    await expect(
+      call("command", { method: "Target.getTargetInfo", params: { targetId: "foreign" } }),
+    ).rejects.toThrow(/outside this native browser/);
+    await call("command", { method: "Storage.getCookies" });
+    expect(guest.debugger.sendCommand).toHaveBeenLastCalledWith("Network.getAllCookies", {});
+    await call("command", {
+      method: "Browser.grantPermissions",
+      params: { permissions: ["geolocation"] },
+    });
+    expect(guest.debugger.sendCommand).toHaveBeenLastCalledWith("Browser.grantPermissions", {
+      permissions: ["geolocation"],
+      browserContextId: "own-context",
+    });
+  });
+
+  test("bounds buffered events and drains only matching events", async () => {
+    const { guest, call } = fixture();
+    await call("command", { method: "Network.enable" });
+    for (let index = 0; index < 260; index++)
+      guest.debugger.emit("message", {}, "Network.requestWillBeSent", { index });
+    guest.debugger.emit("message", {}, "Debugger.paused", { reason: "other" });
+    await expect(call("events", { method: "Debugger.paused", clear: false })).resolves.toEqual({
+      events: [{ method: "Debugger.paused", params: { reason: "other" } }],
+      dropped: 5,
+    });
+    await expect(call("events", { method: "Network.requestWillBeSent" })).resolves.toEqual({
+      events: Array.from({ length: 255 }, (_, index) => ({
+        method: "Network.requestWillBeSent",
+        params: { index: index + 5 },
+      })),
+      dropped: 5,
+    });
+    await expect(call("events")).resolves.toEqual({
+      events: [{ method: "Debugger.paused", params: { reason: "other" } }],
+      dropped: 0,
+    });
+    await expect(call("events")).resolves.toEqual({ events: [], dropped: 0 });
+  });
+
+  test("renews capture demand and restores guest and host throttling after the final viewer stops", async () => {
+    const { host, guest, call } = fixture();
+    await call("frame");
+    expect(host.throttled).toBe(false);
+    expect(guest.throttled).toBe(false);
+    await vi.advanceTimersByTimeAsync(1000);
+    await call("frame");
+    await vi.advanceTimersByTimeAsync(2499);
+    expect(host.throttled).toBe(false);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(host.throttled).toBe(true);
+    expect(guest.throttled).toBe(true);
+    expect(guest.debugger.sendCommand).toHaveBeenLastCalledWith("Page.stopScreencast");
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  test("cleans up capture on detach and guest destruction", async () => {
+    const { host, guest, call } = fixture();
+    await call("frame");
+    guest.debugger.emit("detach");
+    expect(host.throttled).toBe(true);
+    expect(guest.throttled).toBe(true);
+    expect(vi.getTimerCount()).toBe(0);
+    await vi.advanceTimersByTimeAsync(1000);
+    await call("frame");
+    guest.destroyed = true;
+    guest.emit("destroyed");
+    expect(host.throttled).toBe(true);
+    expect(vi.getTimerCount()).toBe(0);
+    await expect(call("command", { method: "DOM.getDocument" })).rejects.toThrow(/closed/);
+  });
+
+  test("restores throttling if capture setup fails and permits a subsequent attempt", async () => {
+    const { host, guest, call } = fixture();
+    guest.debugger.sendCommand.mockRejectedValueOnce(new Error("capture unavailable"));
+    await expect(call("frame")).rejects.toThrow("capture unavailable");
+    expect(host.throttled).toBe(true);
+    expect(guest.throttled).toBe(true);
+    expect(vi.getTimerCount()).toBe(0);
+    await expect(call("frame")).resolves.toMatchObject({ capturedAt: 10000 });
+  });
+  test("discards a pending still screenshot if the guest navigates before it completes", async () => {
+    const { guest, call } = fixture();
+    const screenshot = Promise.withResolvers<unknown>();
+    const started = Promise.withResolvers<void>();
+    guest.debugger.sendCommand.mockImplementation(async (method) => {
+      if (method === "Page.getLayoutMetrics")
+        return { cssVisualViewport: { clientWidth: 800, clientHeight: 600 } };
+      if (method === "Page.captureScreenshot") {
+        started.resolve();
+        return screenshot.promise;
+      }
+      return {};
+    });
+    const capturing = call("frame");
+    await started.promise;
+    guest.emit("did-start-navigation", {}, "https://next.test", false, true);
+    screenshot.resolve({ data: Buffer.from("old page").toString("base64") });
+    await expect(capturing).resolves.toBeNull();
+  });
+});
diff --git a/packages/desktop/src/features/browser-automation/native-bridge.ts b/packages/desktop/src/features/browser-automation/native-bridge.ts
new file mode 100644
index 0000000..c3dc6c5
--- /dev/null
+++ b/packages/desktop/src/features/browser-automation/native-bridge.ts
@@ -0,0 +1,406 @@
+import {
+  NativeBrowserFrameRequestSchema,
+  NativeBrowserCommandRequestSchema,
+  NativeBrowserEventsRequestSchema,
+} from "@getpaseo/protocol/browser-native";
+import { ipcMain, nativeImage, type WebContents } from "electron";
+import type { NativeBrowserEvent, NativeBrowserFrame } from "@getpaseo/protocol/browser-native";
+import {
+  getPaseoBrowserWebContentsForHostWindow,
+  getPaseoBrowserWorkspaceId,
+} from "../browser-webviews/index.js";
+
+interface Capture {
+  tail: Promise<unknown>;
+  events: NativeBrowserEvent[];
+  bytes: number;
+  dropped: number;
+  rawFrame: { data: string; sessionId: number; metadata: { timestamp?: number } } | null;
+  acknowledgements: Set<number>;
+  frame: NativeBrowserFrame | null;
+  streaming: boolean;
+  generation: number;
+  stillTask: Promise<void> | null;
+  lastStillAttemptAt: number;
+  notBefore: number;
+  previousThrottling: boolean | null;
+  host: WebContents | null;
+  stopTimer: ReturnType<typeof setTimeout> | null;
+}
+const MAX_EVENTS = 256;
+const MAX_EVENT_BYTES = 2 * 1024 * 1024;
+const captures = new WeakMap<WebContents, Capture>();
+const hostDemand = new WeakMap<WebContents, { guests: Set<WebContents>; previous: boolean }>();
+function keepHostActive(host: WebContents, guest: WebContents) {
+  let demand = hostDemand.get(host);
+  if (!demand) {
+    demand = { guests: new Set(), previous: host.getBackgroundThrottling() };
+    hostDemand.set(host, demand);
+    host.setBackgroundThrottling(false);
+  }
+  demand.guests.add(guest);
+}
+function releaseHost(capture: Capture, guest: WebContents) {
+  const host = capture.host;
+  if (!host) return;
+  capture.host = null;
+  const demand = hostDemand.get(host);
+  if (!demand) return;
+  demand.guests.delete(guest);
+  if (!demand.guests.size) {
+    if (!host.isDestroyed()) host.setBackgroundThrottling(demand.previous);
+    hostDemand.delete(host);
+  }
+}
+
+function observe(contents: WebContents): Capture {
+  const existing = captures.get(contents);
+  if (existing) return existing;
+  const capture: Capture = {
+    tail: Promise.resolve(),
+    events: [],
+    bytes: 0,
+    dropped: 0,
+    frame: null,
+    rawFrame: null,
+    acknowledgements: new Set(),
+    streaming: false,
+    generation: 0,
+    stillTask: null,
+    lastStillAttemptAt: -Infinity,
+    notBefore: 0,
+    previousThrottling: null,
+    host: null,
+    stopTimer: null,
+  };
+  captures.set(contents, capture);
+  contents.debugger.on("message", (_event, method, params, sessionId) => {
+    if (method === "Page.screencastFrame") {
+      const packet = params as {
+        data: string;
+        sessionId: number;
+        metadata: { timestamp?: number };
+      };
+      if (!capture.streaming || packet.data.length > 8_000_000) {
+        void contents.debugger
+          .sendCommand("Page.screencastFrameAck", { sessionId: packet.sessionId })
+          .catch(() => {});
+        return;
+      }
+      capture.acknowledgements.add(packet.sessionId);
+      capture.rawFrame = packet;
+      return;
+    }
+    // Discovery can mention the app itself; native bridge consumers own only this guest.
+    if (method.startsWith("Target.target")) return;
+    const event = {
+      method,
+      params: params as Record<string, unknown>,
+      ...(sessionId ? { sessionId } : {}),
+    };
+    const size = Buffer.byteLength(JSON.stringify(event));
+    if (size > MAX_EVENT_BYTES) {
+      capture.dropped++;
+      return;
+    }
+    while (capture.events.length >= MAX_EVENTS || capture.bytes + size > MAX_EVENT_BYTES) {
+      capture.bytes -= Buffer.byteLength(JSON.stringify(capture.events.shift()!));
+      capture.dropped++;
+    }
+    capture.events.push(event);
+    capture.bytes += size;
+  });
+  contents.on("did-start-navigation", (_event, _url, _inPlace, isMainFrame) => {
+    if (isMainFrame) {
+      capture.generation++;
+      capture.frame = null;
+      capture.notBefore = Date.now() + 50;
+    }
+  });
+  contents.on("did-navigate", () => {
+    capture.generation++;
+    capture.frame = null;
+    capture.notBefore = Date.now() + 50;
+  });
+  contents.debugger.on("detach", () => {
+    capture.generation++;
+    capture.rawFrame = null;
+    capture.acknowledgements.clear();
+    if (capture.stopTimer) clearTimeout(capture.stopTimer);
+    capture.stopTimer = null;
+    capture.streaming = false;
+    capture.frame = null;
+    if (capture.previousThrottling !== null && !contents.isDestroyed())
+      contents.setBackgroundThrottling(capture.previousThrottling);
+    capture.previousThrottling = null;
+    releaseHost(capture, contents);
+  });
+  contents.once("destroyed", () => {
+    capture.generation++;
+    if (capture.stopTimer) clearTimeout(capture.stopTimer);
+    releaseHost(capture, contents);
+    capture.events = [];
+    capture.bytes = 0;
+  });
+  return capture;
+}
+
+function resolveGuest(sender: WebContents, input: Record<string, unknown>): WebContents {
+  if (typeof input.browserId !== "string" || typeof input.workspaceId !== "string") {
+    throw new Error("Native browser and workspace IDs are required");
+  }
+  const contents = getPaseoBrowserWebContentsForHostWindow(input.browserId, sender.id);
+  if (!contents || getPaseoBrowserWorkspaceId(input.browserId) !== input.workspaceId) {
+    throw new Error("Native browser does not belong to this host window and workspace");
+  }
+  return contents;
+}
+
+interface NativeIpcRegistry {
+  handle(channel: string, listener: (event: unknown, ...args: unknown[]) => unknown): void;
+}
+function hostSender(event: unknown): WebContents {
+  const contents = (event as { sender?: WebContents })?.sender;
+  if (!contents || typeof contents.id !== "number")
+    throw new Error("Native CDP requires a host window");
+  return contents;
+}
+function consumeNativeFrame(contents: WebContents, capture: Capture): void {
+  const rawFrame = capture.rawFrame;
+  capture.rawFrame = null;
+  for (const sessionId of capture.acknowledgements)
+    void contents.debugger.sendCommand("Page.screencastFrameAck", { sessionId }).catch(() => {});
+  capture.acknowledgements.clear();
+  if (
+    rawFrame &&
+    typeof rawFrame.metadata.timestamp === "number" &&
+    rawFrame.metadata.timestamp * 1000 > capture.notBefore
+  ) {
+    const image = nativeImage.createFromBuffer(Buffer.from(rawFrame.data, "base64"));
+    const dimensions = image.getSize();
+    if (
+      dimensions.width > 0 &&
+      dimensions.height > 0 &&
+      dimensions.width <= 1280 &&
+      dimensions.height <= 960
+    ) {
+      // Electron guest canvases may be transparent. JPEG needs an explicit
+      // browser-white canvas; dropping alpha directly makes text disappear.
+      const pixels = image.toBitmap();
+      for (let index = 0; index < pixels.length; index += 4) {
+        const alpha = pixels[index + 3]!;
+        if (alpha === 255) continue;
+        const white = 255 - alpha;
+        pixels[index] = Math.min(255, pixels[index]! + white);
+        pixels[index + 1] = Math.min(255, pixels[index + 1]! + white);
+        pixels[index + 2] = Math.min(255, pixels[index + 2]! + white);
+        pixels[index + 3] = 255;
+      }
+      const data = nativeImage.createFromBitmap(pixels, dimensions).toJPEG(65).toString("base64");
+      if (data.length <= 1_099_900)
+        capture.frame = {
+          data: "data:image/jpeg;base64," + data,
+          ...dimensions,
+          capturedAt: rawFrame.metadata.timestamp * 1000,
+        };
+    }
+  }
+}
+
+async function captureStillFrame(contents: WebContents, capture: Capture): Promise<void> {
+  const generation = capture.generation;
+  const capturedAt = Date.now();
+  const metrics = await contents.debugger.sendCommand("Page.getLayoutMetrics");
+  const viewport = metrics.cssVisualViewport;
+  const width = viewport.clientWidth;
+  const height = viewport.clientHeight;
+  if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0)
+    throw new Error("Native guest viewport is unavailable");
+  const scale = Math.min(1, 1280 / width, 960 / height);
+  const result = await contents.debugger.sendCommand("Page.captureScreenshot", {
+    format: "jpeg",
+    quality: 65,
+    fromSurface: true,
+    captureBeyondViewport: false,
+    clip: { x: 0, y: 0, width, height, scale },
+  });
+  if (contents.isDestroyed() || capture.generation !== generation) return;
+  if (
+    typeof result.data !== "string" ||
+    !/^[A-Za-z0-9+/=]+$/.test(result.data) ||
+    result.data.length > 1_099_900
+  )
+    throw new Error("Native screenshot exceeds the image size limit or is invalid");
+  capture.frame = {
+    data: `data:image/jpeg;base64,${result.data}`,
+    width: Math.max(1, Math.round(width * scale)),
+    height: Math.max(1, Math.round(height * scale)),
+    capturedAt,
+  };
+}
+
+export function registerNativeBrowserBridgeIpc(ipc: NativeIpcRegistry = ipcMain): void {
+  ipc.handle("paseo:browser:native-frame", async (event, raw: unknown) => {
+    const input = NativeBrowserFrameRequestSchema.parse(raw);
+    const contents = resolveGuest(hostSender(event), input);
+    const capture = observe(contents);
+    if (!capture.streaming) {
+      capture.streaming = true;
+      capture.host = hostSender(event);
+      keepHostActive(capture.host, contents);
+      capture.previousThrottling = contents.getBackgroundThrottling();
+      contents.setBackgroundThrottling(false);
+      try {
+        if (!contents.debugger.isAttached()) contents.debugger.attach("1.3");
+        await contents.debugger.sendCommand("Emulation.setDefaultBackgroundColorOverride", {
+          color: { r: 255, g: 255, b: 255, a: 1 },
+        });
+        await contents.debugger.sendCommand("Page.startScreencast", {
+          format: "png",
+          quality: 65,
+          maxWidth: 1280,
+          maxHeight: 960,
+          everyNthFrame: 1,
+        });
+      } catch (error) {
+        capture.streaming = false;
+        if (capture.previousThrottling !== null && !contents.isDestroyed())
+          contents.setBackgroundThrottling(capture.previousThrottling);
+        capture.previousThrottling = null;
+        releaseHost(capture, contents);
+        throw error;
+      }
+    }
+    consumeNativeFrame(contents, capture);
+    if (capture.stopTimer) clearTimeout(capture.stopTimer);
+    capture.stopTimer = setTimeout(() => {
+      if (!contents.isDestroyed())
+        void contents.debugger.sendCommand("Page.stopScreencast").catch(() => {});
+      capture.streaming = false;
+      if (capture.previousThrottling !== null && !contents.isDestroyed())
+        contents.setBackgroundThrottling(capture.previousThrottling);
+      capture.previousThrottling = null;
+      releaseHost(capture, contents);
+      capture.frame = null;
+      capture.rawFrame = null;
+      capture.acknowledgements.clear();
+      capture.stopTimer = null;
+    }, 2500);
+    const frame = capture.frame;
+    const fresh =
+      frame && frame.capturedAt + 1500 > Date.now() && frame.capturedAt > (input.notBefore ?? 0);
+    if (!fresh && Date.now() > capture.notBefore) {
+      // Screencast frames arrive only on paint. Refresh quiet pages with a bounded
+      // screenshot rather than relabeling an old paint with a new timestamp.
+      if (!capture.stillTask && Date.now() - capture.lastStillAttemptAt >= 1000) {
+        capture.lastStillAttemptAt = Date.now();
+        capture.stillTask = captureStillFrame(contents, capture).finally(() => {
+          capture.stillTask = null;
+        });
+      }
+      if (capture.stillTask) await capture.stillTask;
+    }
+    return capture.frame &&
+      capture.frame.capturedAt + 1500 > Date.now() &&
+      capture.frame.capturedAt > (input.notBefore ?? 0)
+      ? capture.frame
+      : null;
+  });
+  ipc.handle("paseo:browser:native-command", async (event, raw: unknown) => {
+    const input = NativeBrowserCommandRequestSchema.parse(raw);
+    const contents = resolveGuest(hostSender(event), input);
+    const method = input.method;
+    const contextMethods = new Set([
+      "Browser.grantPermissions",
+      "Browser.resetPermissions",
+      "Browser.setPermission",
+      "Browser.setDownloadBehavior",
+    ]);
+    if (
+      method.startsWith("Browser.") &&
+      method !== "Browser.getVersion" &&
+      !contextMethods.has(method)
+    )
+      throw new Error("This browser-level command is outside the native guest");
+
+    if (
+      method.startsWith("Target.") &&
+      !["Target.getTargets", "Target.getTargetInfo"].includes(method)
+    ) {
+      throw new Error("Use native browser tab tools for target lifecycle operations");
+    }
+    const params = input.params ?? {};
+    if (params.browserContextId !== undefined)
+      throw new Error("Explicit browser contexts are outside the native guest");
+    if (Buffer.byteLength(JSON.stringify(params)) > MAX_EVENT_BYTES)
+      throw new Error("CDP parameters exceed the size limit");
+    const capture = observe(contents);
+    const execute = async () => {
+      if (contents.isDestroyed()) throw new Error("Native browser was closed");
+      if (!contents.debugger.isAttached()) contents.debugger.attach("1.3");
+      if (method === "Target.getTargets" || method === "Target.getTargetInfo") {
+        const own = await contents.debugger.sendCommand("Target.getTargetInfo");
+        if (params.targetId && params.targetId !== own.targetInfo.targetId)
+          throw new Error("Target is outside this native browser");
+        return method === "Target.getTargets" ? { targetInfos: [own.targetInfo] } : own;
+      }
+
+      const cookies: Record<string, string> = {
+        "Storage.getCookies": "Network.getAllCookies",
+        "Storage.setCookies": "Network.setCookies",
+        "Storage.clearCookies": "Network.clearBrowserCookies",
+      };
+      if (cookies[method]) return contents.debugger.sendCommand(cookies[method], params);
+      if (contextMethods.has(method)) {
+        const own = await contents.debugger.sendCommand("Target.getTargetInfo");
+        if (!own.targetInfo.browserContextId)
+          throw new Error("Native guest browser context is unavailable");
+        return contents.debugger.sendCommand(method, {
+          ...params,
+          browserContextId: own.targetInfo.browserContextId,
+        });
+      }
+      return contents.debugger.sendCommand(method, params);
+    };
+    // A pending Runtime command can wait for a dialog reply or debugger resume.
+    // Queueing its unblocker behind it would leave the guest permanently paused.
+    const unblockers = new Set([
+      "Page.handleJavaScriptDialog",
+      "Debugger.evaluateOnCallFrame",
+      "Debugger.getScriptSource",
+      "Runtime.getProperties",
+      "Debugger.resume",
+      "Debugger.stepInto",
+      "Debugger.stepOut",
+      "Debugger.stepOver",
+      "Debugger.disable",
+      "Runtime.terminateExecution",
+      "Runtime.runIfWaitingForDebugger",
+      "Fetch.continueRequest",
+      "Fetch.continueResponse",
+      "Fetch.fulfillRequest",
+      "Fetch.failRequest",
+      "Fetch.continueWithAuth",
+      "Fetch.disable",
+    ]);
+    if (unblockers.has(method)) return execute();
+    const pending = capture.tail.then(execute);
+    capture.tail = pending.catch(() => undefined);
+    return pending;
+  });
+  ipc.handle("paseo:browser:native-events", (event, raw: unknown) => {
+    const input = NativeBrowserEventsRequestSchema.parse(raw);
+    const capture = observe(resolveGuest(hostSender(event), input));
+    const matches = (item: NativeBrowserEvent) =>
+      typeof input.method !== "string" || item.method === input.method;
+    const events = capture.events.filter(matches);
+    if (input.clear !== false) capture.events = capture.events.filter((item) => !matches(item));
+    capture.bytes = capture.events.reduce(
+      (sum, item) => sum + Buffer.byteLength(JSON.stringify(item)),
+      0,
+    );
+    const dropped = capture.dropped;
+    if (input.clear !== false) capture.dropped = 0;
+    return { events, dropped };
+  });
+}
