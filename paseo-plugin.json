{
  "id": "paseo-browser",
  "name": "Paseo Browser",
  "requirements": {
    "paseo": ">=0.15.0"
  },
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts"
    ],
    [
      "node",
      "server/prepare.mjs"
    ],
    [
      "node",
      "server/workspace/prepare-runtime.mjs"
    ],
    [
      "node",
      "server/install-agent-skill.mjs"
    ]
  ],
  "description": "Shared native Chromium for Paseo agents, desktop DevTools and mobile viewing",
  "media": [
    "assets/native-desktop.png",
    "assets/native-mobile.png"
  ]
}
